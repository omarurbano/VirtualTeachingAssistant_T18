# Synthetic Data Generation Pipeline — Configuration
# Copy to .env or export as environment variables.

# ─── NVIDIA NIM API ─────────────────────────────────────────────────────────────
# Get your key from https://build.nvidia.com/settings/api-keys
NIM_API_KEY=your_nim_api_key_here
NIM_API_BASE=https://integrate.api.nvidia.com/v1
# Recommended models:
#   meta/llama-3.1-70b-instruct  (high quality, slower)
#   meta/llama-3.1-8b-instruct   (faster, cheaper)
#   nvidia/nemotron-4-340b-instruct
NIM_MODEL=meta/llama-3.1-70b-instruct

# ─── SharePoint / Microsoft Graph ──────────────────────────────────────────────
# NOTE: If your data is already synced via OneDrive, you do NOT need these.
# The --mode onedrive path uses local files and skips SharePoint auth entirely.
#
# If you still need direct SharePoint access:
#   1. Go to https://portal.azure.com/ → App registrations → New registration
#   2. Set redirect URI to http://localhost
#   3. Grant API permission: Microsoft Graph → Sites.Read.All (Application permission)
#   4. Grant admin consent if required by your tenant.
#   5. Create a client secret and paste below.
#
# AUTH FLOW SELECTION:
#   Option A — Device code flow (recommended if app-only is blocked by Conditional Access):
#     Set SHAREPOINT_CLIENT_ID and SHAREPOINT_USERNAME below.
#     On first run you will get a device-code prompt in the terminal.
#     The resulting refresh token is cached in .sharepoint_token_cache.json.
#
#   Option B — App-only / client-secret (may be blocked by Conditional Access):
#     Set SHAREPOINT_CLIENT_ID and SHAREPOINT_CLIENT_SECRET below.
#
SHAREPOINT_CLIENT_ID=your-client-id-here
SHAREPOINT_CLIENT_SECRET=your-client-secret-here
SHAREPOINT_USERNAME=you@email.wsu.edu
# SHAREPOINT_PASSWORD=your-password
SHAREPOINT_TENANT_ID=common
SHAREPOINT_TENANT=emailwsu-my.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Shared
SHAREPOINT_DRIVE_NAME=Documents

# ─── OneDrive Local Sync (preferred when SharePoint auth is restricted) ─────────
# If your teammate's SharePoint folder is synced to your local OneDrive folder,
# use --mode onedrive and optionally set ONEDRIVE_INPUT_DIR to that path.
# Example:
#   ONEDRIVE_INPUT_DIR=C:\Users\nsudi\OneDrive - Washington State University (email.wsu.edu)\SharedFolder
ONEDRIVE_INPUT_DIR=

# ─── Pipeline Settings ─────────────────────────────────────────────────────────
NUM_VARIANTS_PER_SEED=3       # synthetic augmentations per seed Q&A pair
MIN_CHUNK_CHARS=120           # minimum text chunk size
MAX_CHUNK_CHARS=1200          # maximum text chunk size
NUM_Q_PER_CHUNK=4             # Q&A pairs generated per text chunk
TEMPERATURE_SEED=0.6          # LLM temperature for seed generation
TEMPERATURE_AUGMENT=0.7       # LLM temperature for synthetic augmentation

# ─── NVIDIA NeMo Fine-tuning (post-generation) ─────────────────────────────────
# See: Synthetic_Data_Generation/nemo_finetune/
FINETUNE_BASE_MODEL=nvidia/nemotron-4-7b-instruct
FINETUNE_OUTPUT_DIR=./nemo_output
FINETUNE_EPOCHS=3
FINETUNE_BATCH_SIZE=4
FINETUNE_LORA_RANK=16
FINETUNE_LORA_ALPHA=32
