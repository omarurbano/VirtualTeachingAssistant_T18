# Synthetic Data Generation Pipeline — Configuration
# Copy to .env or export as environment variables.

# ─── NVIDIA NIM API ─────────────────────────────────────────────────────────────
NIM_API_KEY=your_nim_api_key_here
NIM_API_BASE=https://integrate.api.nvidia.com/v1
# Recommended models:
#   meta/llama-3.1-70b-instruct  (high quality, slower)
#   meta/llama-3.1-8b-instruct   (faster, cheaper)
#   nvidia/nemotron-4-340b-instruct
NIM_MODEL=meta/llama-3.1-70b-instruct

# ─── Google Drive OAuth ─────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create project → Enable Drive API → Create OAuth 2.0 Client ID (Desktop app)
# 3. Download JSON and save as credentials.json in this directory
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:8080

# ─── Pipeline Settings ─────────────────────────────────────────────────────────
NUM_VARIANTS_PER_SEED=3       # synthetic augmentations per seed Q&A pair
MIN_CHUNK_CHARS=120           # minimum text chunk size
MAX_CHUNK_CHARS=1200          # maximum text chunk size
NUM_Q_PER_CHUNK=4             # Q&A pairs generated per text chunk
TEMPERATURE_SEED=0.6          # LLM temperature for seed generation
TEMPERATURE_AUGMENT=0.7       # LLM temperature for synthetic augmentation

# ─── NVIDIA NeMo Fine-tuning (post-generation) ─────────────────────────────────
# See: Synthetic_Data_Generation/nemo_finetune/
FINETUNE_BASE_MODEL=nvidia/nemotron-4-7b-instruct
FINETUNE_OUTPUT_DIR=./nemo_output
FINETUNE_EPOCHS=3
FINETUNE_BATCH_SIZE=4
FINETUNE_LORA_RANK=16
FINETUNE_LORA_ALPHA=32
