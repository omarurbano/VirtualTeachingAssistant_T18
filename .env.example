# VTA Backend Environment Variables
# Copy to .env and fill in values

# Model Server (Ollama on Kamiak cluster via tunnel/proxy)
USE_MODEL_SERVER=true
MODEL_SERVER_URL=http://localhost:11434
MODEL_SERVER_API_KEY=
MODEL_NAME=vta-assistant
MODEL_TIMEOUT_SEC=60
MODEL_MAX_TOKENS=512
MODEL_TEMPERATURE=0.2

# Embeddings (Ollama on cluster)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cluster Ingest Service
CLUSTER_INGEST_URL=http://localhost:9000

# Node Backend
NODE_API_URL=http://localhost:3000

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Flask
UPLOAD_FOLDER=./uploads
FLASK_ENV=production